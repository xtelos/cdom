{
	"name": "cdom",
	"version": "0.2.1",
	"description": "Build DOM trees from nested closures.",
	"type": "module",
	"main": "dist/cdom.min.js",
	"types": "dist/cdom.d.ts",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "./build.sh",
		"typecheck": "node_modules/.bin/tsc --noEmit --project tsconfig.production.json",
		"pretest": "npm run build",
		"test": "node --test test/*.test.mjs",
		"check:dist": "./check-dist.sh",
		"verify": "npm run typecheck && npm test && npm run check:dist"
	},
	"devDependencies": {
		"jsdom": "26.1.0",
		"terser": "5.50.0",
		"typescript": "5.9.3"
	}
}
